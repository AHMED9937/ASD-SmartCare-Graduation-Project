# ASD SmartCare - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ==============================================================================
# API Configuration
# ==============================================================================

# Backend API base URL (required)
# Default development server: https://asdproject-two.vercel.app/
API_BASE_URL=https://your-api-url.com/

# ==============================================================================
# Stripe Payment Configuration
# ==============================================================================
# Get your keys from: https://dashboard.stripe.com/apikeys

# Publishable key (safe for client-side, starts with pk_)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# NOTE: STRIPE_SECRET_KEY is server-side only and should NOT be stored
# in the client app. Configure it in your backend environment.

# ==============================================================================
# Firebase Configuration (Optional - for App Distribution)
# ==============================================================================

# Firebase App ID (found in Firebase Console > Project Settings)
# FIREBASE_APP_ID=1:123456789:android:abcdef

# ==============================================================================
# Usage Instructions
# ==============================================================================
# 
# Option 1: Using .env file (development)
#   1. Copy this file: cp .env.example .env
#   2. Fill in your values
#   3. The app will read from .env via flutter_dotenv
#
# Option 2: Using --dart-define (CI/CD)
#   flutter run \
#     --dart-define=API_BASE_URL=https://api.example.com/ \
#     --dart-define=STRIPE_PUBLISHABLE_KEY=pk_test_xxx
#
# Option 3: GitHub Actions Secrets
#   Add these as repository secrets, then reference in workflow
